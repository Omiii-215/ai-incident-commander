# Local development defaults. Never put real secrets in this file.
APP_ENV=local
AUTH_MODE=dev
PUBLIC_APP_ORIGIN=http://localhost:3000
API_PORT=4000
# Port 27018 avoids clashing with a standalone mongod on 27017.
MONGODB_URI=mongodb://127.0.0.1:27018/aic?replicaSet=rs0
REDIS_URL=redis://127.0.0.1:6379
# Local-only signing keys (dev values; production must use secret-manager references)
CURSOR_SIGNING_KEY=dev-cursor-signing-key-change-me
SESSION_SIGNING_KEY=dev-session-signing-key-change-me
OBJECT_STORAGE_DIR=.data/objects
MODEL_PROVIDER_PROFILE=fake-deterministic-v1
ACTIONS_ENABLED=false
# Synthetic connector webhook secret, referenced by secretRef "synthetic-alerts-dev"
SECRET_SYNTHETIC_ALERTS_DEV=dev-synthetic-webhook-secret
SECRET_SYNTHETIC_ALERTS_GLOBEX=dev-globex-webhook-secret
